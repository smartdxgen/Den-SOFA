            r, p = pearsonr(df[f], df[target])
            rho, p2 = spearmanr(df[f], df[target])
            print(f"{f:20}: Pearson r={r:.3f} (p={p:.4f}), Spearman ρ={rho:.3f} (p={p2:.4f})")
